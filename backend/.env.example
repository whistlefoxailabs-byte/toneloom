# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# LLM — OpenRouter (single gateway for GPT / Claude / Gemini / etc.)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_SITE_URL=https://www.toneloom.pro
OPENROUTER_APP_NAME=ToneLoom
DEFAULT_LLM=gpt-4o-mini

# Optional — only needed for embeddings fallback, not chat
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=

# Creem (https://creem.io) — billing / subscriptions
# Paste these when you have them from Creem Dashboard (API key + product/store IDs):
#   CREEM_API_KEY          → Developers → API Key
#   CREEM_WEBHOOK_SECRET   → Developers → Webhook signing secret
#   CREEM_PRODUCT_PRO         → Pro $12/mo
#   CREEM_PRODUCT_PRO_YEARLY  → Pro $79/yr
#   CREEM_PRODUCT_BYOK        → BYOK $4/mo
#   CREEM_PRODUCT_BYOK_YEARLY → BYOK $29/yr
#   CREEM_PRODUCT_TEAM        → optional Team product ID
# Webhook URL to register in Creem: https://YOUR-RAILWAY-API/billing/webhook
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_PRO=
CREEM_PRODUCT_PRO_YEARLY=
CREEM_PRODUCT_BYOK=
CREEM_PRODUCT_BYOK_YEARLY=
CREEM_PRODUCT_TEAM=
CREEM_TEST_MODE=true
# Plain URL only. Creem rejects ?checkout=success and adds its own query params.
CREEM_SUCCESS_URL=https://www.toneloom.pro

# App
FRONTEND_URL=https://www.toneloom.pro
CORS_ORIGINS=chrome-extension://your-extension-id,https://www.toneloom.pro,https://toneloom.pro
